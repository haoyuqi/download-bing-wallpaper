{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "haoyuqi/download-bing-wallpaper",
    "description": "Retrieve Bing wallpaper metadata by date through a versioned JSON Artisan command.",
    "type": "library",
    "keywords": [
        "artisan",
        "bing",
        "bing-wallpaper",
        "laravel",
        "metadata",
        "wallpaper"
    ],
    "homepage": "https://github.com/haoyuqi/download-bing-wallpaper",
    "license": "MIT",
    "authors": [
        {
            "name": "Hao Yuqi",
            "email": "hi.haoyuqi+github@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/haoyuqi/download-bing-wallpaper/issues",
        "source": "https://github.com/haoyuqi/download-bing-wallpaper"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/console": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Haoyuqi\\DownloadBingWallpaper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Haoyuqi\\DownloadBingWallpaper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "format": "@php vendor/bin/pint --parallel",
        "format:check": "@php vendor/bin/pint --parallel --test",
        "test": "@php vendor/bin/phpunit",
        "check": [
            "@composer validate --strict --no-check-lock",
            "@composer dump-autoload --optimize --strict-psr",
            "@analyse",
            "@format:check",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Haoyuqi\\DownloadBingWallpaper\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
